# MongoDB Atlas Baglanti Dizesi
MONGODB_URI=mongodb+srv://<kullanici_adi>:<sifre>@cluster0.mongodb.net/bre?appName=BreDB

# NextAuth.js Gizli Anahtari (openssl rand -hex 32)
AUTH_SECRET=gizli-nextauth-anahtariniz-en-az-32-karakter

# Cloudinary Medya Depolama Bilgileri
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Uygulama Adresi
NEXTAUTH_URL=http://localhost:3000
